# VoxGuard API: FastAPI + SQLite + ffmpeg (codec simulation).
# Default: StubDetector only. Build with --build-arg INSTALL_ML=1 to add the `ml` extra
# (torch etc.) needed for VOXGUARD_DETECTOR=real, with a CPU-only torch (docker/ml_cpu.sh).
FROM python:3.11-slim-bookworm

ARG INSTALL_ML=0
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH

# ffmpeg provides the G.711 / AMR / GSM / Opus encoders used by simulate_codec=true.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.13.6 /uv /usr/local/bin/uv

WORKDIR /app
# Dependencies first (cached unless pyproject.toml / uv.lock change), then the project.
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY docker/ml_cpu.sh docker/ml-cpu-skip.txt docker/torch-cpu.txt docker/check_ml_cpu.py docker/
RUN --mount=type=cache,target=/root/.cache/uv \
    sh docker/ml_cpu.sh sync --no-install-project --extra api
# INSTALL_ML=1 only: CPU-only torch and torchaudio, pinned with per-architecture hashes in
# docker/torch-cpu.txt instead of taken from uv.lock, whose Linux wheels are CUDA builds.
# torch is the locked 2.15.0 (+cpu). torchaudio is 2.11.0+cpu while uv.lock has 2.11.1: the
# locked 2.11.1 Linux wheel needs the CUDA runtime (libcudart, libtorch_cuda) and the CPU index
# has no 2.11.1; on amd64 the pinned pair gave bit-identical resampling and RawNet2 scores to the
# locked pair (14 Nov 2026). The step fails the build unless the environment is CPU-only.
RUN --mount=type=cache,target=/root/.cache/uv sh docker/ml_cpu.sh torch
COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    sh docker/ml_cpu.sh sync --no-editable --extra api \
    && sh docker/ml_cpu.sh check

# Non-root user (uid 1000 also matches Hugging Face Spaces). /data holds the SQLite DB and
# the Hugging Face cache; mount a volume there to keep them across restarts.
RUN useradd --create-home --uid 1000 voxguard && mkdir -p /data && chown voxguard /data
USER voxguard
# UV_NO_SYNC: a `uv run` in the container must not sync the environment to uv.lock, which
# would replace the CPU-only torch with the CUDA build.
ENV VOXGUARD_DB_URL=sqlite:////data/voxguard.db \
    HF_HOME=/data/hf-cache \
    UV_NO_SYNC=1

EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4)"]
CMD ["uvicorn", "voxguard.api.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
