# Variable names only. Copy to .env (never commit .env).
VOXGUARD_DETECTOR=stub          # stub | real
VOXGUARD_MODEL_REPO=            # local path or Hugging Face Hub repo id (real detector)
VOXGUARD_THRESHOLD=             # empty: thresholds.json next to the checkpoint, else 0.5. Any value overrides both
HF_TOKEN=
WANDB_API_KEY=
# API (defaults shown; invalid values make the app fail at startup)
VOXGUARD_MAX_UPLOAD_MB=25
VOXGUARD_MAX_AUDIO_SECONDS=60
VOXGUARD_DB_URL=sqlite:///./voxguard.db   # docker compose overrides this with the /data volume
# Prevention layer. eer (default): flag at VOXGUARD_THRESHOLD, else thresholds.json (phone value), else 0.5.
# low_far: flag at VOXGUARD_LOW_FAR_THRESHOLD, which MUST be set (no default; the app refuses to
# start without it). It is a manually configured operating point, not an evaluation-derived one.
VOXGUARD_THRESHOLD_MODE=eer
VOXGUARD_LOW_FAR_THRESHOLD=
# UI: where the Streamlit app finds the API (docker compose sets http://api:8000 itself)
VOXGUARD_API_URL=http://localhost:8000
# Codec simulation for /v1/analyze (simulate_codec=true). No default: without it the API answers 501.
# One of: g711_mulaw g711_alaw amr_nb amr_wb gsm opus. Needs ffmpeg with that encoder on PATH.
# The Docker images' ffmpeg (Debian) has no AMR encoders: use g711_mulaw (or gsm/opus) there.
VOXGUARD_SIMULATE_CODEC=
# docker compose only (see docs/deployment.md)
INSTALL_ML=0                    # 1 = build the API image with the ml extra (needed for real)
VOXGUARD_API_PORT=8000          # host port for the API
VOXGUARD_UI_PORT=8501           # host port for the UI
VOXGUARD_UI_MAX_UPLOAD_MB=25    # UI uploader limit, whole MB; keep it <= VOXGUARD_MAX_UPLOAD_MB
VOXGUARD_API_START_PERIOD=20s   # API health-check grace period; use 600s for the real detector
# Real detector device (API): cpu (default) | cuda | auto
VOXGUARD_DEVICE=cpu
# Hugging Face Space only: seconds to wait for the API (default 600 for real, 60 for stub)
VOXGUARD_API_START_TIMEOUT=
