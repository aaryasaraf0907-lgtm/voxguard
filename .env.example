# Variable names only. Copy to .env (never commit .env).
VOXGUARD_DETECTOR=stub          # stub | real
VOXGUARD_MODEL_REPO=            # local path or Hugging Face Hub repo id (real detector)
VOXGUARD_THRESHOLD=0.5          # fake_score >= threshold -> "fake"
HF_TOKEN=
WANDB_API_KEY=
# API (defaults shown; invalid values make the app fail at startup)
VOXGUARD_MAX_UPLOAD_MB=25
VOXGUARD_MAX_AUDIO_SECONDS=60
VOXGUARD_DB_URL=sqlite:///./voxguard.db
# Prevention layer. eer (default): flag at the detector's own threshold.
# low_far: flag at VOXGUARD_LOW_FAR_THRESHOLD, which MUST be set (no default; the app refuses to
# start without it). It is a manually configured operating point, not an evaluation-derived one.
VOXGUARD_THRESHOLD_MODE=eer
VOXGUARD_LOW_FAR_THRESHOLD=
# UI: where the Streamlit app finds the API
VOXGUARD_API_URL=http://localhost:8000
# Codec simulation for /v1/analyze (simulate_codec=true). No default: without it the API answers 501.
# One of: g711_mulaw g711_alaw amr_nb amr_wb gsm opus. Needs ffmpeg with that encoder on PATH.
VOXGUARD_SIMULATE_CODEC=
